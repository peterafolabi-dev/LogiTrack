DEBUG=1
SECRET_KEY=replace-with-strong-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
PORT=8000

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# Object Storage (local media for DEBUG=1; required in production)
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Use the bucket's AWS region, or auto for Cloudflare R2.
AWS_S3_REGION_NAME=auto
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@logitrack.local
